#version 450
layout(local_size_x = 8, local_size_y = 8) in;

struct Tri { vec4 v0; vec4 v1; vec4 v2; uint mat; };

layout(std430, binding = 0) buffer Tris { Tri tris[]; };
layout(std430, binding = 1) buffer Nodes { ivec4 nodes[]; };
layout(std430, binding = 2) buffer Out { vec4 pixels[]; };

uniform vec3 cam_origin;
uniform vec2 resolution;
uniform uint frame_seed;
uniform uint spp;

uint rng_state;

uint pcg(uint v) {
    uint s = v * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    return (w >> 22u) ^ w;
}

float rand() {
    rng_state = pcg(rng_state);
    return float(rng_state) / 4294967295.0;
}

vec3 cosine_hemi(vec3 n) {
    float u1 = rand();
    float u2 = rand();
    float r = sqrt(u1);
    float phi = 6.2831853 * u2;
    vec3 a = abs(n.x) > 0.9 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 t = normalize(cross(n, a));
    vec3 b = cross(n, t);
    return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(1.0 - u1));
}

bool hit_tri(Tri t, vec3 o, vec3 d, out float tout, out vec3 nout) {
    vec3 e1 = t.v1.xyz - t.v0.xyz;
    vec3 e2 = t.v2.xyz - t.v0.xyz;
    vec3 pv = cross(d, e2);
    float det = dot(e1, pv);
    if (abs(det) < 1e-7) return false;
    float inv = 1.0 / det;
    vec3 tv = o - t.v0.xyz;
    float u = dot(tv, pv) * inv;
    if (u < 0.0 || u > 1.0) return false;
    vec3 qv = cross(tv, e1);
    float v = dot(d, qv) * inv;
    if (v < 0.0 || u + v > 1.0) return false;
    float tt = dot(e2, qv) * inv;
    if (tt <= 1e-4) return false;
    tout = tt;
    nout = normalize(cross(e1, e2));
    return true;
}

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (id.x >= int(resolution.x) || id.y >= int(resolution.y)) return;
    rng_state = pcg(uint(id.x) ^ pcg(uint(id.y) ^ pcg(frame_seed)));

    vec3 acc = vec3(0.0);
    for (uint s = 0; s < spp; ++s) {
        vec2 uv = (vec2(id) + vec2(rand(), rand())) / resolution;
        vec3 d = normalize(vec3(uv * 2.0 - 1.0, 1.0));
        vec3 o = cam_origin;
        vec3 thr = vec3(1.0);
        vec3 rad = vec3(0.0);

        for (int depth = 0; depth < 8; ++depth) {
            float bestT = 1e30;
            vec3 bestN = vec3(0.0);
            int bestMat = -1;

            for (int i = 0; i < tris.length(); ++i) {
                float tt;
                vec3 nn;
                if (hit_tri(tris[i], o, d, tt, nn) && tt < bestT) {
                    bestT = tt;
                    bestN = nn;
                    bestMat = int(tris[i].mat);
                }
            }

            if (bestMat < 0) {
                rad += thr * mix(vec3(1.0), vec3(0.5, 0.7, 1.0), 0.5 * (d.y + 1.0));
                break;
            }

            vec3 albedo = bestMat == 0 ? vec3(0.9, 0.1, 0.1) : vec3(0.8);
            vec3 n = dot(d, bestN) < 0.0 ? bestN : -bestN;
            o += d * bestT + n * 1e-4;
            d = cosine_hemi(n);
            thr *= albedo;
        }
        acc += rad;
    }
    pixels[id.y * int(resolution.x) + id.x] = vec4(acc / float(spp), 1.0);
}
